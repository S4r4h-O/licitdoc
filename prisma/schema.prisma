generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------- USUÁRIOS E EMPRESAS -------------------

// Empresa contratada (a que usa o sistema para participar de licitações)
model Company {
  id           String  @id @default(uuid()) @db.Uuid
  clerkOrgId   String? @unique // ID da organização no Clerk (auth provider)
  razaoSocial  String  @unique @db.VarChar(150)
  nomeFantasia String  @db.VarChar(100)
  logo         String?
  cnpj         String  @unique @db.VarChar(18)
  email        String  @unique @db.VarChar(50)
  phone        String? @db.VarChar(20)

  // Endereço completo (campos separados para permitir filtragem por estado/cidade)
  addressStreet     String
  addressNumber     String
  addressComplement String?
  addressCountry    String
  addressCity       String
  addressState      String  @db.VarChar(2)
  addressZip        String  @db.VarChar(9)

  status CompanyStatus @default(ATIVA)
  plan   Plans?

  members                User[]
  documentRequirements   DocumentRequirement[] // Catálogo de tipos de documento da empresa
  licitacoes             Licitacao[] // Licitações acompanhadas pela empresa
  contractingAuthorities ContractingAuthority[] // Órgãos públicos cadastrados pela empresa

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([plan])
  @@index([addressState])
  @@index([addressCity])
  @@index([addressCity, addressState])
}

enum CompanyStatus {
  ATIVA
  INATIVA
}

enum Plans {
  GRATUITO
  PRO
}

// Usuário membro de uma empresa (pode ser null se ainda não vinculado a uma empresa)
model User {
  id      String  @id @default(uuid()) @db.Uuid
  clerkId String  @unique // ID do usuário no Clerk (auth provider)
  email   String  @unique
  name    String?
  image   String?

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  documentRequirements DocumentRequirement[] // Requisitos criados por este usuário

  @@index([companyId])
}

// ------------------- ÓRGÃOS -------------------

// Órgão público contratante (prefeitura, autarquia, etc.) cadastrado pela empresa
model ContractingAuthority {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @db.Uuid // Empresa que cadastrou este órgão
  name         String  @db.VarChar(100)
  addressState String?
  addressCity  String?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  licitacoes Licitacao[] // Licitações abertas por este órgão

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// ------------------- LICITAÇÕES -------------------

// Processo licitatório que a empresa está acompanhando ou participando
model Licitacao {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid // Empresa participante
  contractorId    String    @db.Uuid // Órgão público que abriu a licitação
  licitacaoNumber String?   @db.VarChar(50) // Número da licitação (ex: Pregão 001/2025)
  processNumber   String? // Número do processo administrativo vinculado
  openingDate     DateTime? // Data de abertura do certame

  requirements LicitacaoRequirement[] // Tipos de documento exigidos por esta licitação
  submissions  LicitacaoSubmission[] // Arquivos submetidos para esta licitação
  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractor   ContractingAuthority   @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([openingDate])
}

// ------------------- DOCUMENTOS E REQUISITOS -------------------

// Esfera de validade do documento (define de qual nível de governo o documento emana)
enum JurisdictionLevel {
  FEDERAL
  ESTADUAL
  MUNICIPAL
  OUTRO
}

enum DocumentStatus {
  VALIDO
  INVALIDO
}

// Tipo de documento exigível (ex: "Certidão Negativa Federal", "Balanço Patrimonial")
// Atua como catálogo reutilizável de requisitos documentais da empresa
model DocumentRequirement {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @db.Uuid
  userId            String             @db.Uuid // Usuário que criou este requisito
  name              String             @unique @db.VarChar(100)
  jurisdictionLevel JurisdictionLevel? // Esfera do documento (federal, estadual, municipal)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  documents  DocumentFile[] // Arquivos concretos que satisfazem este tipo de documento
  licitacoes LicitacaoRequirement[] // Licitações que exigem este tipo de documento

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([userId])
}

// TODO: CONNECT FILE TO ORGANIZATION
// Arquivo concreto de um documento (instância física de um DocumentRequirement)
model DocumentFile {
  id                    String @id @default(uuid()) @db.Uuid
  documentRequirementId String @db.Uuid // Tipo de documento ao qual este arquivo pertence

  fileName String
  fileUrl  String?
  fileSize Int?

  issuingAuthority String? // Órgão emissor do documento
  issueDate        DateTime? // Data de emissão
  expirationDate   DateTime? // Data de validade (usado para alertas de vencimento)
  documentNumber   String? // Número do documento (ex: número da certidão)

  s3Key String? @unique // Chave do arquivo no bucket S3

  status DocumentStatus @default(VALIDO)

  deletedAt DateTime? // Soft delete: arquivo removido mas mantido no banco

  requirement DocumentRequirement   @relation(fields: [documentRequirementId], references: [id], onDelete: Cascade)
  submissions LicitacaoSubmission[] // Licitações para as quais este arquivo foi submetido

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  @@index([documentRequirementId])
  @@index([status])
  @@index([expirationDate])
  @@index([deletedAt])
}

// ------------------- RELAÇÕES -------------------

// Vínculo entre uma licitação e um tipo de documento exigido por ela
// Representa "esta licitação exige este tipo de documento"
// É o nó central que permite rastrear quais requisitos foram ou não atendidos por submissions
model LicitacaoRequirement {
  id            String @id @default(uuid()) @db.Uuid
  licitacaoId   String @db.Uuid
  requirementId String @db.Uuid

  licitacao   Licitacao            @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  requirement DocumentRequirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  submission  LicitacaoSubmission? // Preenchido quando um arquivo for submetido para este requisito

  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([licitacaoId, requirementId]) // Um requisito não pode ser duplicado dentro da mesma licitação
  @@index([licitacaoId])
  @@index([requirementId])
}

// Registro de qual DocumentFile foi submetido para qual requisito de qual licitação
// Criado quando uma pasta zip é gerada
// ATENÇÃO: licitacaoId é redundante com licitacaoRequirement.licitacaoId — risco de inconsistência
model LicitacaoSubmission {
  id                     String  @id @default(uuid()) @db.Uuid
  licitacaoId            String  @db.Uuid // Redundante se licitacaoRequirementId estiver preenchido
  licitacaoRequirementId String? @unique @db.Uuid // Nullable: submission pode existir sem requisito formal
  documentFileId         String  @db.Uuid

  licitacao            Licitacao             @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  licitacaoRequirement LicitacaoRequirement? @relation(fields: [licitacaoRequirementId], references: [id], onDelete: Cascade)
  documentFile         DocumentFile          @relation(fields: [documentFileId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([licitacaoId, documentFileId]) // Um arquivo não pode ser submetido duas vezes na mesma licitação
  @@index([licitacaoId])
  @@index([licitacaoRequirementId])
  @@index([documentFileId])
}
